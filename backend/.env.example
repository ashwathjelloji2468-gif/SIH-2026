PROJECT_NAME="ECDAT Backend"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="dev-secret-key-change-in-production-do-not-use-hardcoded"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
DATABASE_URL="sqlite:///./ecdat.db"

# Storage & Sandbox Paths
STORAGE_PATH="./data_storage"
SANDBOX_PATH="./sandbox_storage"

# Default Mosca Threat Horizon (Years)
DEFAULT_QUANTUM_THREAT_HORIZON=2033
